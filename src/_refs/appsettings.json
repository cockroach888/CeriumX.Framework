  //"urls": "http://127.0.0.1:5257;",
  "WebView2Configure": {
    "VirtualHostDomain": "devops.ceriumx.vip",
    "VirtualHostFolder": "wwwroot",
    "WebView2RuntimeFolder": "D:\\WebView2Runtime",
    "WebView2UserDataFolder": "UserCacheData"
  }
}